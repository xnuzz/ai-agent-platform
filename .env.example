# Copy to .env for docker compose / local dev. NEVER commit real values.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://platform:platform@db:5432/platform
POSTGRES_PASSWORD=platform
REDIS_URL=redis://redis:6379/0
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
# Default email transport (console = prints, sends nothing). Workspaces can add an SMTP Integration instead.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
AGENT_TASK_LEASE_SECONDS=300

# --- Agent workers (Team 1 / Team 2). Token from: manage.py create_agent_token --agent <AGENT> --name <name>
PLATFORM_API_URL=http://backend:8000
AGENT_1_PLATFORM_TOKEN=
AGENT_2_PLATFORM_TOKEN=
# LLM provider config is owned by each agent team (see docs/SYSTEM_ARCHITECTURE.md §LLM providers)
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
# Agent 1 web search (brave | serpapi)
AGENT_1_SEARCH_PROVIDER=brave
AGENT_1_SEARCH_API_KEY=
# Agent 2 business discovery (osm needs no key | google_places)
AGENT_2_DISCOVERY_PROVIDER=osm
GOOGLE_PLACES_API_KEY=
# Public page describing the Agent 2 crawler (sent in its User-Agent; no personal email)
CRAWLER_INFO_URL=
